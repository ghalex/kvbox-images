#!/usr/bin/env python3
# kvbox-redis-password (kvbox #176): give the server a new password. Named as "password" in
# /etc/kvbox/image.json; the host runs it through kvbox-agent's "script" with one JSON line on stdin:
#
#   {"password": "…"}   ->   {"user": "default"}
#
# The running server takes it at once (CONFIG SET requirepass, asked with the password it has now,
# over the local socket) and /etc/valkey/kvbox-auth.conf is rewritten, so the next start has it too.
# The new file is written first and renamed only after the server said OK: a failure leaves both the
# server and the file with the old password. The password reaches valkey-cli on stdin (-x), never
# argv. Connections already open stay open; they authenticated with the old one.
# The host then stores the new password as the box's REDIS_PASSWORD; nothing here reads it again
# (kvbox-redis-init runs once).
import json
import os
import re
import shutil
import subprocess
import sys

AUTH = "/etc/valkey/kvbox-auth.conf"
SOCKET = "/run/valkey/valkey.sock"


def fail(msg):
    print(f"kvbox-redis-password: {msg}", file=sys.stderr)
    sys.exit(1)


def current():
    try:
        with open(AUTH, encoding="utf-8") as f:
            m = re.search(r'^requirepass "(.*)"$', f.read(), re.M)
    except OSError:
        m = None
    if not m:
        fail("the server has no password yet (kvbox-redis-init has not finished)")
    return re.sub(r"\\(.)", r"\1", m.group(1))


def main():
    try:
        req = json.loads(sys.stdin.readline())
    except ValueError:
        fail("expected one JSON line on stdin")
    password = req.get("password") if isinstance(req, dict) else None
    if not isinstance(password, str) or not password or any(ord(c) < 32 or ord(c) == 127 for c in password):
        fail("'password' must be a non-empty single line")
    old = current()

    tmp = AUTH + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write('requirepass "%s"\n' % password.replace("\\", "\\\\").replace('"', '\\"'))
        f.flush()
        os.fsync(f.fileno())
    shutil.chown(tmp, "valkey", "valkey")

    r = subprocess.run(["valkey-cli", "-s", SOCKET, "-x", "config", "set", "requirepass"], input=password, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                       text=True, timeout=20, env=dict(os.environ, VALKEYCLI_AUTH=old))
    if r.returncode != 0 or r.stdout.strip() != "OK":
        os.unlink(tmp)
        lines = (r.stdout + r.stderr).strip().splitlines()
        fail(lines[-1] if lines else "valkey-cli failed")
    os.rename(tmp, AUTH)
    print(json.dumps({"user": "default"}))


main()
