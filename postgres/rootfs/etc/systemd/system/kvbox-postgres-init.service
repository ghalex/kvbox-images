# Once per box: the role, database and password from the box owner's POSTGRES_* variables (kvbox #87).
# Not a oneshot, so waiting for the host's env push never holds up the boot.
[Unit]
Description=kvbox: Postgres role and database from the box owner's environment (once)
ConditionPathExists=!/var/lib/kvbox/postgres-init.done
Wants=postgresql.service
After=postgresql.service kvbox-agent.service

[Service]
Type=exec
ExecStart=/usr/local/sbin/kvbox-postgres-init

[Install]
WantedBy=multi-user.target
