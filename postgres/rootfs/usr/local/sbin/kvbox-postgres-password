#!/usr/bin/env python3
# kvbox-postgres-password (kvbox #173): give a role a new password. Named as "password" in
# /etc/kvbox/image.json; the host runs it through kvbox-agent's "script" with one JSON line on stdin:
#
#   {"user": "orders", "password": "…"}   ->   {"user": "orders"}
#
# The superuser "postgres" does it over the local socket, so the old password is not needed. The
# values reach psql through the environment (\getenv) and are quoted by psql itself, never argv.
# "postgres" itself is refused: it has no password and no network login, and stays that way.
# The host then stores the new password as the box's POSTGRES_PASSWORD; nothing here reads it again
# (kvbox-postgres-init runs once).
import json
import os
import subprocess
import sys

SQL = r"""
\getenv u KVBOX_PG_USER
\getenv p KVBOX_PG_PASSWORD
SELECT format('ALTER ROLE %I LOGIN PASSWORD %L', :'u', :'p') \gexec
"""


def fail(msg):
    print(f"kvbox-postgres-password: {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    try:
        req = json.loads(sys.stdin.readline())
    except ValueError:
        fail("expected one JSON line on stdin")
    user = req.get("user") if isinstance(req, dict) else None
    password = req.get("password") if isinstance(req, dict) else None
    if not isinstance(user, str) or not user or "\n" in user or "\0" in user:
        fail("'user' is missing")
    if user == "postgres":
        fail("the postgres superuser has no password")
    if not isinstance(password, str) or not password or "\n" in password or "\0" in password:
        fail("'password' must be a non-empty single line")
    env = dict(os.environ, KVBOX_PG_USER=user, KVBOX_PG_PASSWORD=password)
    r = subprocess.run(["runuser", "-u", "postgres", "--", "psql", "-X", "-q", "-v", "ON_ERROR_STOP=1", "-d", "postgres"],
                       input=SQL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, env=env, timeout=20)
    if r.returncode != 0:
        lines = r.stderr.strip().splitlines()
        fail(lines[-1] if lines else "psql failed")
    print(json.dumps({"user": user}))


main()
