# Once per box: the data directory from the box owner's GARAGE_DATA, Garage's configuration, and this
# node made the whole cluster (kvbox #182). Not a oneshot, so waiting for the host's env push never
# holds up the boot.
[Unit]
Description=kvbox: Garage's data directory, configuration and single-node layout (once)
ConditionPathExists=!/var/lib/kvbox/garage-init.done
After=kvbox-agent.service kvbox-volumes.service

[Service]
Type=exec
ExecStart=/usr/local/sbin/kvbox-garage-init

[Install]
WantedBy=multi-user.target
