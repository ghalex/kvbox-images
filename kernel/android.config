# The android kernel (kernel-android/): everything in kvbox.config plus binder, which Android's own
# processes talk through. Only boxes of the android image boot it (its image.json says
# "kernel": "android"); every other box keeps the kernel without binder.
CONFIG_ANDROID_BINDER_IPC=y
# binderfs: Redroid mounts its own instance inside its container; no /dev/binder exists until then.
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""

# Off (Firecracker's CI config turns it on): with RT group scheduling on cgroup v2, every container's
# group has no real-time budget, so Android's SCHED_FIFO requests are refused and Bluetooth aborts
# in a loop ("unable to enable real time scheduling"), stalling system_server (kvbox #202).
# CONFIG_RT_GROUP_SCHED is not set

# PSI on at boot (Firecracker's CI config builds it but leaves it off without psi=1): Android 14's lmkd
# needs /proc/pressure and exits without it, and system_server then waits on lmkd holding its main lock
# at every app start, until the watchdog kills it (kvbox #202).
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
