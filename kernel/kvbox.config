# kvbox additions on top of Firecracker's CI config (firecracker-ci-x86_64-6.1.config).
# Merged with scripts/kconfig/merge_config.sh; the build fails if any line below is not
# in the final .config, so a typo or a dependency that quietly disables an option is caught.

CONFIG_LOCALVERSION="-kvbox"
# /proc/config.gz, so `docker`'s check-config.sh and curious users can see what is built in.
CONFIG_IKCONFIG_PROC=y

# Docker 28+ adds a rule to the iptables `raw` table for every container; without the table
# no container with networking can start.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y

# nf_tables: Ubuntu's iptables uses the nft backend by default, and Docker can use it directly.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_BRIDGE_REJECT=y

# Network drivers Docker and VPNs reach for.
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_TUN=y
CONFIG_NET_CLS_CGROUP=y

# FUSE: sshfs, rclone mount, AppImages, BuildKit.
CONFIG_FUSE_FS=y

# Kubernetes (k3s, kvbox #213). kube-proxy spreads a Service over its pods with the `statistic`
# match; without it its whole rule sync fails as soon as a Service has two pods. `recent` is
# its session affinity. k3s's network policy controller (kube-router) keeps pod addresses in
# ipsets, logs what it drops with `limit` + NFLOG, and tells bridged pod traffic apart with
# `physdev`: without that one its rule sync fails on every run.
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_IP_SET=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
# IPVS: `k3s check-config` asks for the `ipvs` match; the rest is the least kube-proxy's ipvs
# mode needs (round robin, TCP and UDP). Not the default mode.
CONFIG_IP_VS=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_NFCT=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
# Matches other network plugins and service meshes reach for (Calico and Cilium's connmark,
# Istio and Linkerd's owner, MSS clamping for tunnels, LOG).
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
