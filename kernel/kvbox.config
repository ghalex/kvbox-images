# kvbox additions on top of Firecracker's CI config (firecracker-ci-x86_64-6.1.config).
# Merged with scripts/kconfig/merge_config.sh; the build fails if any line below is not
# in the final .config, so a typo or a dependency that quietly disables an option is caught.

CONFIG_LOCALVERSION="-kvbox"
# /proc/config.gz, so `docker`'s check-config.sh and curious users can see what is built in.
CONFIG_IKCONFIG_PROC=y

# Docker 28+ adds a rule to the iptables `raw` table for every container; without the table
# no container with networking can start.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y

# nf_tables: Ubuntu's iptables uses the nft backend by default, and Docker can use it directly.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_BRIDGE_REJECT=y

# Network drivers Docker and VPNs reach for.
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_TUN=y
CONFIG_NET_CLS_CGROUP=y

# FUSE: sshfs, rclone mount, AppImages, BuildKit.
CONFIG_FUSE_FS=y
