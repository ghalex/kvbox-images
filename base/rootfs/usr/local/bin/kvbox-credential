#!/usr/bin/env python3
# kvbox-credential: ask the host for the credential of an integration (kvbox issue #205).
#
#   kvbox-credential github            # the answer as one JSON line
#   kvbox-credential --token github    # the token alone; prints nothing when there is none
#
# An integration is an account (GitHub) the box's owner connected once in the kvbox web app and
# turned on for this box (`kvbox vm set <box> --integration github`). Nothing of it is kept in the
# box: this asks each time, over vsock, the one channel that is this box's alone (host CID 2, port
# 53; one JSON line each way), so a disconnect works at once and a snapshot, a fork or a backup of
# the box carries no secret. Any user in the box may ask: that is what "on" means.
#
# The answer is {"ok": true, "kind", "token", "expiresAt"?, "identity"?} or
# {"ok": false, "code", "message", "connected"?}. The exit code says which:
#   0 a credential     3 off (not turned on for this box)     4 not-connected (the account is not)
#   5 needs-reconnect  6 unavailable (never for this box, or the host could not say)
import json
import socket
import sys

HOST_CID = 2
PORT = 53
TIMEOUT = 20
EXIT = {"off": 3, "not-connected": 4, "needs-reconnect": 5, "unavailable": 6}


def ask(integration):
    try:
        s = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
        s.settimeout(TIMEOUT)
        s.connect((HOST_CID, PORT))
        s.sendall((json.dumps({"op": "credential", "integration": integration}) + "\n").encode())
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
        s.close()
        answer = json.loads(buf.split(b"\n", 1)[0].decode())
        if not isinstance(answer, dict) or not isinstance(answer.get("ok"), bool):
            raise ValueError("not an answer")
        return answer
    except (OSError, ValueError):
        # No listener on the host: a kvbox-server from before integrations, or a box not made by kvbox.
        return {"ok": False, "code": "unavailable", "message": "this box's host does not answer for integrations"}


def main():
    args = sys.argv[1:]
    token_only = "--token" in args
    names = [a for a in args if not a.startswith("-")]
    if len(names) != 1:
        print("usage: kvbox-credential [--token] <integration>   (e.g. github)", file=sys.stderr)
        return 2
    answer = ask(names[0])
    if token_only:
        if answer["ok"]:
            print(answer.get("token", ""))
    else:
        print(json.dumps(answer))
    return 0 if answer["ok"] else EXIT.get(answer.get("code"), 6)


if __name__ == "__main__":
    sys.exit(main())
