#!/usr/bin/env python3
# kvbox-agent: the host's control channel into a box, over vsock (no network involved, so it
# works whatever the box did to its own networking). One JSON object per line, one request per
# connection:
#
#   {"op": "ping"}                      -> {"ok": true, "name": "<hostname>"}
#   {"op": "identity", "name": "box2", "ip": "172.30.0.3", "prefixLen": 24, "gateway": "172.30.0.1",
#    "mac": "06:00:AC:1E:00:03", "time": 1760000000}
#                                       -> {"ok": true}
#   {"op": "authorizedKeys", "lines": ["ssh-ed25519 AAAA… host", "cert-authority,… AAAA…"]}
#                                       -> {"ok": true, "lines": 2}
#   {"op": "stats"}                     -> {"ok": true, "load": [0.12, 0.08, 0.01], "cpus": 2,
#                                           "memTotalMib": 3920, "memUsedMib": 412,
#                                           "diskTotalBytes": 8350000000, "diskUsedBytes": 2100000000,
#                                           "uptimeSec": 5321}
#   {"op": "dropVolumes"}               -> {"ok": true, "dropped": ["/mnt/data"]}
#   {"op": "env", "vars": [["DB_URL", "postgres://…"], ["NODE_ENV", "production"]]}
#                                       -> {"ok": true, "vars": 2, "changed": true}
#
# "identity" is what a box restored from a snapshot gets: it wakes up believing it is still the
# box the snapshot was taken from (same name, IP, MAC and clock in memory), and the host tells it
# who it is now before plugging its network cable in. "authorizedKeys" replaces the kvbox user's
# authorized_keys with exactly these lines: a restored or woken box has the file it was frozen
# with, and the host has the current one (its own key plus the lines the control plane gave the
# box, which change when the SSH CA does). "stats" is what `kvbox vm top` shows: the box's own load,
# memory (used = total - available, so page cache counts as free) and root disk, from /proc and
# statvfs only, no subprocess. "dropVolumes" is for a box restored from a snapshot that had a volume
# attached (kvbox issue #52): the memory image still has it mounted, but the disk under it is now an
# empty placeholder, so every mount of an extra disk (/dev/vdc and up) is force-unmounted, deepest
# first; lazy, so a process holding a file there gets an error instead of blocking the unmount.
# "env" is the box owner's environment variables (kvbox issue #88), sent at every boot and after a
# restore; the whole list replaces the previous one. Two files, one per reader, each in the only
# form its reader takes literally: /etc/kvbox/env for systemd's EnvironmentFile= (double-quoted,
# `\` and `"` escaped; the `kvbox-app` unit of `kvbox deploy` reads it and is restarted when the
# list changed) and the kvbox user's ~/.ssh/environment for sshd (PermitUserEnvironment, plain
# KEY=value, so `kvbox connect` and `kvbox exec` sessions get them). pam_env was ruled out: it cuts
# a value at `#` even inside quotes. A value cannot hold a newline in either file.
# Errors come back as {"ok": false, "error"}.
import json
import os
import pwd
import re
import socket
import subprocess
import sys
import time

PORT = 52
IFACE = "eth0"
SSH_USER = "kvbox"


def log(msg):
    print(f"kvbox-agent: {msg}", file=sys.stderr, flush=True)


def sh(*argv):
    subprocess.run(argv, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)


def set_hostname(name):
    with open("/etc/hostname", "w") as f:
        f.write(name + "\n")
    sh("hostname", name)
    with open("/etc/hosts") as f:
        lines = f.read().splitlines()
    out = [f"127.0.1.1 {name}" if line.startswith("127.0.1.1") else line for line in lines]
    if not any(line.startswith("127.0.1.1") for line in out):
        out.append(f"127.0.1.1 {name}")
    with open("/etc/hosts", "w") as f:
        f.write("\n".join(out) + "\n")


def set_network(ip, prefix_len, gateway, mac):
    # The link goes down for the MAC change; IPv6 link-local is regenerated from the new MAC on the way up.
    sh("ip", "link", "set", IFACE, "down")
    sh("ip", "link", "set", IFACE, "address", mac)
    sh("ip", "-4", "addr", "flush", "dev", IFACE)
    sh("ip", "link", "set", IFACE, "up")
    sh("ip", "addr", "add", f"{ip}/{prefix_len}", "dev", IFACE)
    sh("ip", "route", "replace", "default", "via", gateway, "dev", IFACE)


def set_time(epoch):
    sh("date", "-s", f"@{int(epoch)}")


def set_authorized_keys(lines):
    if not isinstance(lines, list) or not lines or not all(isinstance(l, str) and l.strip() and "\n" not in l for l in lines):
        raise ValueError("authorizedKeys: 'lines' must be a non-empty list of single-line strings")
    user = pwd.getpwnam(SSH_USER)
    ssh_dir = os.path.join(user.pw_dir, ".ssh")
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    os.chown(ssh_dir, user.pw_uid, user.pw_gid)
    path = os.path.join(ssh_dir, "authorized_keys")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("".join(line.strip() + "\n" for line in lines))
    os.chmod(tmp, 0o600)
    os.chown(tmp, user.pw_uid, user.pw_gid)
    os.replace(tmp, path)
    return len(lines)


def stats():
    with open("/proc/loadavg") as f:
        load = [float(x) for x in f.read().split()[:3]]
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            mem[key] = int(rest.split()[0])  # kB
    total = mem["MemTotal"]
    avail = mem.get("MemAvailable", mem.get("MemFree", 0))
    fs = os.statvfs("/")
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])
    return {
        "ok": True,
        "load": load,
        "cpus": os.cpu_count() or 1,
        "memTotalMib": total // 1024,
        "memUsedMib": (total - avail) // 1024,
        "diskTotalBytes": fs.f_blocks * fs.f_frsize,
        "diskUsedBytes": (fs.f_blocks - fs.f_bfree) * fs.f_frsize,
        "uptimeSec": int(uptime),
    }


ENV_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
ENV_FILE = "/etc/kvbox/env"
APP_SERVICE = "kvbox-app.service"


def write_atomic(path, text, mode, uid=0, gid=0):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.chown(tmp, uid, gid)
    os.replace(tmp, path)


def systemd_quoted(value):
    return value.replace("\\", "\\\\").replace('"', '\\"')


def set_env(pairs):
    if not isinstance(pairs, list) or not all(
        isinstance(p, list) and len(p) == 2 and isinstance(p[0], str) and ENV_NAME.match(p[0])
        and isinstance(p[1], str) and "\n" not in p[1] and "\r" not in p[1] and "\0" not in p[1]
        for p in pairs
    ):
        raise ValueError("env: 'vars' must be a list of [name, value] pairs, single-line values")
    systemd = "".join(f'{k}="{systemd_quoted(v)}"\n' for k, v in pairs)
    try:
        with open(ENV_FILE) as f:
            changed = f.read() != systemd
    except FileNotFoundError:
        changed = True
    os.makedirs(os.path.dirname(ENV_FILE), mode=0o755, exist_ok=True)
    write_atomic(ENV_FILE, systemd, 0o600)
    user = pwd.getpwnam(SSH_USER)
    ssh_dir = os.path.join(user.pw_dir, ".ssh")
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    os.chown(ssh_dir, user.pw_uid, user.pw_gid)
    write_atomic(os.path.join(ssh_dir, "environment"), "".join(f"{k}={v}\n" for k, v in pairs), 0o600, user.pw_uid, user.pw_gid)
    if changed:
        sh("systemctl", "try-restart", "--no-block", APP_SERVICE)
    return len(pairs), changed


VOLUME_DEV = re.compile(r"^/dev/vd[c-z]+$")  # vda is the base image, vdb the box's own disk


def drop_volumes():
    with open("/proc/mounts") as f:
        mounts = [line.split()[:2] for line in f]
    targets = sorted((m[1] for m in mounts if VOLUME_DEV.match(m[0])), key=len, reverse=True)
    for target in targets:
        sh("umount", "-f", "-l", target)
    return targets


def handle(req):
    op = req.get("op")
    if op == "ping":
        return {"ok": True, "name": socket.gethostname()}
    if op == "identity":
        set_hostname(req["name"])
        set_network(req["ip"], int(req.get("prefixLen", 24)), req["gateway"], req["mac"])
        if "time" in req:
            set_time(req["time"])
        log(f"now {req['name']} at {req['ip']} ({req['mac']})")
        return {"ok": True}
    if op == "authorizedKeys":
        n = set_authorized_keys(req.get("lines"))
        log(f"authorized_keys of {SSH_USER} replaced ({n} lines)")
        return {"ok": True, "lines": n}
    if op == "stats":
        return stats()
    if op == "dropVolumes":
        dropped = drop_volumes()
        if dropped:
            log(f"volume mounts dropped: {', '.join(dropped)}")
        return {"ok": True, "dropped": dropped}
    if op == "env":
        n, changed = set_env(req.get("vars"))
        log(f"environment: {n} variables{', changed' if changed else ''}")
        return {"ok": True, "vars": n, "changed": changed}
    raise ValueError(f"unknown op {op!r}")


def serve(conn):
    with conn, conn.makefile("rb") as rd, conn.makefile("wb") as wr:
        line = rd.readline()
        if not line:
            return
        try:
            reply = handle(json.loads(line))
        except subprocess.CalledProcessError as e:
            reply = {"ok": False, "error": f"{' '.join(e.cmd)}: {e.stderr.strip()}"}
        except Exception as e:  # noqa: BLE001 - report anything to the host rather than die
            reply = {"ok": False, "error": str(e)}
        wr.write(json.dumps(reply).encode() + b"\n")
        wr.flush()


def main():
    srv = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    srv.bind((socket.VMADDR_CID_ANY, PORT))
    srv.listen(8)
    log(f"listening on vsock port {PORT}")
    while True:
        try:
            conn, _ = srv.accept()
        except OSError as e:
            log(f"accept: {e}")
            time.sleep(0.1)
            continue
        try:
            serve(conn)
        except OSError as e:
            log(f"connection: {e}")


if __name__ == "__main__":
    main()
