#!/usr/bin/env python3
# kvbox-agent: the host's control channel into a box, over vsock (no network involved, so it
# works whatever the box did to its own networking). One JSON object per line, one request per
# connection:
#
#   {"op": "ping"}                      -> {"ok": true, "name": "<hostname>"}
#   {"op": "identity", "name": "box2", "ip": "172.30.0.3", "prefixLen": 24, "gateway": "172.30.0.1",
#    "mac": "06:00:AC:1E:00:03", "time": 1760000000}
#                                       -> {"ok": true}
#   {"op": "authorizedKeys", "lines": ["ssh-ed25519 AAAA… host", "cert-authority,… AAAA…"]}
#                                       -> {"ok": true, "lines": 2}
#   {"op": "stats"}                     -> {"ok": true, "load": [0.12, 0.08, 0.01], "cpus": 2,
#                                           "memTotalMib": 3920, "memUsedMib": 412,
#                                           "diskTotalBytes": 8350000000, "diskUsedBytes": 2100000000,
#                                           "uptimeSec": 5321}
#   {"op": "dropVolumes"}               -> {"ok": true, "dropped": ["/mnt/data"]}
#   {"op": "env", "vars": [["DB_URL", "postgres://…"], ["NODE_ENV", "production"]]}
#                                       -> {"ok": true, "vars": 2, "changed": true}
#   {"op": "idle", "path": "/usr/local/sbin/kvbox-idle"}
#                                       -> {"ok": true, "idle": true}
#   {"op": "script", "path": "/usr/local/sbin/kvbox-postgres-status", "input": {"any": "json"}}
#                                       -> {"ok": true, "output": {"any": "json"}}
#   {"op": "run", "id": "cr_8f3a", "command": "node ~/app/embed.js", "timeoutSec": 600}
#                                       -> {"ok": true, "started": true}
#   {"op": "runStatus", "id": "cr_8f3a"}
#                                       -> {"ok": true, "state": "exited", "exitCode": 0, "durationMs": 34}
#   {"op": "runOutput", "id": "cr_8f3a", "stream": "stdout", "offset": 0, "limit": 1048576}
#                                       -> {"ok": true, "size": 12, "offset": 0, "data": "aGVsbG8gd29ybGQK"}
#
# "identity" is what a box restored from a snapshot gets: it wakes up believing it is still the
# box the snapshot was taken from (same name, IP, MAC and clock in memory), and the host tells it
# who it is now before plugging its network cable in. "authorizedKeys" replaces the kvbox user's
# authorized_keys with exactly these lines: a restored or woken box has the file it was frozen
# with, and the host has the current one (its own key plus the lines the control plane gave the
# box, which change when the SSH CA does). "stats" is what `kvbox vm top` shows: the box's own load,
# memory (used = total - available, so page cache counts as free) and root disk, from /proc and
# statvfs only, no subprocess. "dropVolumes" is for a box restored from a snapshot that had a volume
# attached (kvbox issue #52): the memory image still has it mounted, but the disk under it is now an
# empty placeholder, so every mount of an extra disk (/dev/vdc and up) is force-unmounted, deepest
# first; lazy, so a process holding a file there gets an error instead of blocking the unmount.
# "env" is the box owner's environment variables (kvbox issue #88), sent at every boot and after a
# restore; the whole list replaces the previous one. Two files, one per reader, each in the only
# form its reader takes literally: /etc/kvbox/env for systemd's EnvironmentFile= (double-quoted,
# `\` and `"` escaped; the units of `kvbox deploy` read it, and every one that does is restarted
# when the list changed, see env_units) and the kvbox user's ~/.ssh/environment for sshd (PermitUserEnvironment, plain
# KEY=value, so `kvbox connect` and `kvbox exec` sessions get them). pam_env was ruled out: it cuts
# a value at `#` even inside quotes. A value cannot hold a newline in either file. Every successful
# "env" also touches /run/kvbox/env-ready (tmpfs, so absent at each boot until the first push).
# "idle" is for a box that decides itself when it is idle (kvbox issue #102): the host keeps the box's
# idle check (its image's "idle" from /etc/kvbox/image.json by default, or one its owner set with
# `kvbox vm set --idle-check`) and sends its path; it is run (as root, at most IDLE_TIMEOUT seconds)
# and exit 0 means idle, anything else busy. The host asks once a minute, only for a box that has a
# check, and hibernates it after its auto-hibernate time of idle answers in a row. Each connection has its
# own thread so a slow script never holds up another request; every op but "idle", "script", "runStatus" and "runOutput" still runs one at a time.
# "script" is how the host asks an image something only the image knows (kvbox issue #173: a managed
# Postgres's status, a password reset). The image names its scripts in /etc/kvbox/image.json
# ("scripts"), the host sends the path; it is run as root with "input" (any JSON, null when absent) as
# one JSON line on stdin, at most SCRIPT_TIMEOUT seconds, and must print one JSON value, which comes
# back as "output". A non-zero exit is an error carrying the last line the script wrote to stderr.
# Input goes over stdin, never argv: it may hold a password.
# "run" starts a command of the box owner's and does not wait for it (kvbox issue #190: a cron trigger
# that runs a command; the host asks "runStatus" until it is over). The command is a transient systemd
# unit, kvbox-run-<id>.service, never a child of this agent: it outlives an agent restart, systemd kills
# everything it started when "timeoutSec" is up, and systemd is what remembers how it ended. It runs as
# the kvbox user in its home through a login shell (`bash -lc`), with the owner's variables
# (/etc/kvbox/env), and what it prints goes to /var/log/kvbox/runs/<id>.out (stdout) and <id>.err
# (stderr), of which the newest RUNS_KEPT runs are kept. The same id twice starts nothing ("started": false): the host may ask again
# after an answer it never got. "runStatus" answers "running", "exited" (with "exitCode"; 128 + the
# signal for a command a signal ended), "timeout" (killed at its deadline) or "unknown": no such run,
# which is also what a run becomes when the box restarts, since systemd's memory of it is gone.
# An ended run also carries "durationMs", how long the command itself ran by systemd's own clock: the
# host only learns of the end at its next question, seconds later, so its own count would be too long.
# "runOutput" reads a run's output back (kvbox issue #188: `exec` over the API): "stream" is "stdout" or
# "stderr", at most "limit" bytes (RUN_OUTPUT_MAX, 1 MiB) from "offset". "data" is those bytes in base64
# (a command may print anything, and a cut may fall inside a UTF-8 character), "size" the file's whole
# length, so the asker knows what it did not get. A run with no file (not started yet, pruned, or one
# that never wrote to that stream) is size 0, never an error. A run started by an agent from before
# this op (base v0.15.x) has a single <id>.log with both streams together: it is read as stdout, and
# its stderr is empty.
# Errors come back as {"ok": false, "error"}.
import base64
import glob
import json
import os
import pwd
import re
import socket
import subprocess
import sys
import threading
import time

PORT = 52
IFACE = "eth0"
SSH_USER = "kvbox"


def log(msg):
    print(f"kvbox-agent: {msg}", file=sys.stderr, flush=True)


def sh(*argv):
    subprocess.run(argv, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)


def set_hostname(name):
    with open("/etc/hostname", "w") as f:
        f.write(name + "\n")
    sh("hostname", name)
    with open("/etc/hosts") as f:
        lines = f.read().splitlines()
    out = [f"127.0.1.1 {name}" if line.startswith("127.0.1.1") else line for line in lines]
    if not any(line.startswith("127.0.1.1") for line in out):
        out.append(f"127.0.1.1 {name}")
    with open("/etc/hosts", "w") as f:
        f.write("\n".join(out) + "\n")


def set_network(ip, prefix_len, gateway, mac):
    # The link goes down for the MAC change; IPv6 link-local is regenerated from the new MAC on the way up.
    sh("ip", "link", "set", IFACE, "down")
    sh("ip", "link", "set", IFACE, "address", mac)
    sh("ip", "-4", "addr", "flush", "dev", IFACE)
    sh("ip", "link", "set", IFACE, "up")
    sh("ip", "addr", "add", f"{ip}/{prefix_len}", "dev", IFACE)
    sh("ip", "route", "replace", "default", "via", gateway, "dev", IFACE)


def set_time(epoch):
    sh("date", "-s", f"@{int(epoch)}")


def set_authorized_keys(lines):
    if not isinstance(lines, list) or not lines or not all(isinstance(l, str) and l.strip() and "\n" not in l for l in lines):
        raise ValueError("authorizedKeys: 'lines' must be a non-empty list of single-line strings")
    user = pwd.getpwnam(SSH_USER)
    ssh_dir = os.path.join(user.pw_dir, ".ssh")
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    os.chown(ssh_dir, user.pw_uid, user.pw_gid)
    path = os.path.join(ssh_dir, "authorized_keys")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("".join(line.strip() + "\n" for line in lines))
    os.chmod(tmp, 0o600)
    os.chown(tmp, user.pw_uid, user.pw_gid)
    os.replace(tmp, path)
    return len(lines)


def stats():
    with open("/proc/loadavg") as f:
        load = [float(x) for x in f.read().split()[:3]]
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            mem[key] = int(rest.split()[0])  # kB
    total = mem["MemTotal"]
    avail = mem.get("MemAvailable", mem.get("MemFree", 0))
    fs = os.statvfs("/")
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])
    return {
        "ok": True,
        "load": load,
        "cpus": os.cpu_count() or 1,
        "memTotalMib": total // 1024,
        "memUsedMib": (total - avail) // 1024,
        "diskTotalBytes": fs.f_blocks * fs.f_frsize,
        "diskUsedBytes": (fs.f_blocks - fs.f_bfree) * fs.f_frsize,
        "uptimeSec": int(uptime),
    }


ENV_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
ENV_FILE = "/etc/kvbox/env"
# Touched after every env push. /run is a tmpfs, so its absence means "no env yet this boot": a
# unit that needs the owner's variables (the postgres image's kvbox-postgres-init, kvbox #87) waits for it.
ENV_READY = "/run/kvbox/env-ready"
UNIT_DIR = "/etc/systemd/system"
SSH_ENV_FILE = "/home/kvbox/.ssh/environment"
# The image's own units are never restarted for a variable: this agent among them.
OWN_UNITS = ("kvbox-agent.service", "kvbox-init.service", "kvbox-volumes.service")


def env_units():
    """The `kvbox deploy` units that read the owner's variables (kvbox #167): `kvbox-app` of a single
    app and `kvbox-<service>` of a stack. Told by what the unit file names, not by a list of names:
    a Node unit has EnvironmentFile=/etc/kvbox/env, a container's has --env-file ~/.ssh/environment.
    A stack's database reads neither (its password is its own file), so a changed variable never
    restarts it."""
    units = []
    for path in sorted(glob.glob(os.path.join(UNIT_DIR, "kvbox-*.service"))):
        name = os.path.basename(path)
        if name in OWN_UNITS:
            continue
        try:
            with open(path) as f:
                text = f.read()
        except OSError:
            continue
        if ENV_FILE in text or SSH_ENV_FILE in text:
            units.append(name)
    return units


def write_atomic(path, text, mode, uid=0, gid=0):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.chown(tmp, uid, gid)
    os.replace(tmp, path)


def systemd_quoted(value):
    return value.replace("\\", "\\\\").replace('"', '\\"')


def set_env(pairs):
    if not isinstance(pairs, list) or not all(
        isinstance(p, list) and len(p) == 2 and isinstance(p[0], str) and ENV_NAME.match(p[0])
        and isinstance(p[1], str) and "\n" not in p[1] and "\r" not in p[1] and "\0" not in p[1]
        for p in pairs
    ):
        raise ValueError("env: 'vars' must be a list of [name, value] pairs, single-line values")
    systemd = "".join(f'{k}="{systemd_quoted(v)}"\n' for k, v in pairs)
    try:
        with open(ENV_FILE) as f:
            changed = f.read() != systemd
    except FileNotFoundError:
        changed = True
    os.makedirs(os.path.dirname(ENV_FILE), mode=0o755, exist_ok=True)
    write_atomic(ENV_FILE, systemd, 0o600)
    user = pwd.getpwnam(SSH_USER)
    ssh_dir = os.path.join(user.pw_dir, ".ssh")
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    os.chown(ssh_dir, user.pw_uid, user.pw_gid)
    write_atomic(os.path.join(ssh_dir, "environment"), "".join(f"{k}={v}\n" for k, v in pairs), 0o600, user.pw_uid, user.pw_gid)
    # The marker before the app restart: a unit waiting for it must never depend on kvbox-app (kvbox #104).
    os.makedirs(os.path.dirname(ENV_READY), mode=0o755, exist_ok=True)
    with open(ENV_READY, "a"):
        os.utime(ENV_READY)
    units = env_units() if changed else []
    if units:
        # try-restart: only a unit that is running; one the owner stopped stays stopped.
        r = subprocess.run(["systemctl", "try-restart", "--no-block", *units],
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if r.returncode not in (0, 5):
            raise subprocess.CalledProcessError(r.returncode, r.args, stderr=r.stderr)
    return len(pairs), changed


VOLUME_DEV = re.compile(r"^/dev/vd[c-z]+$")  # vda is the base image, vdb the box's own disk


def drop_volumes():
    with open("/proc/mounts") as f:
        mounts = [line.split()[:2] for line in f]
    targets = sorted((m[1] for m in mounts if VOLUME_DEV.match(m[0])), key=len, reverse=True)
    for target in targets:
        sh("umount", "-f", "-l", target)
    return targets


IDLE_TIMEOUT = 10


def idle(script):
    if not isinstance(script, str) or not script.startswith("/"):
        raise ValueError("idle needs the script's absolute path")
    r = subprocess.run([script], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=IDLE_TIMEOUT)
    return r.returncode == 0


SCRIPT_TIMEOUT = 30
SCRIPT_MAX_OUTPUT = 1 << 20


def script(path, data):
    if not isinstance(path, str) or not path.startswith("/"):
        raise ValueError("script needs the script's absolute path")
    if not os.path.isfile(path):
        raise ValueError(f"script {path} is not in this image")
    try:
        r = subprocess.run([path], input=json.dumps(data) + "\n", stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           text=True, timeout=SCRIPT_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise ValueError(f"script {path} did not finish within {SCRIPT_TIMEOUT}s") from None
    if r.returncode != 0:
        lines = r.stderr.strip().splitlines()
        raise ValueError(lines[-1] if lines else f"script {path} failed (exit {r.returncode})")
    if len(r.stdout) > SCRIPT_MAX_OUTPUT:
        raise ValueError(f"script {path} printed more than {SCRIPT_MAX_OUTPUT} bytes")
    try:
        return json.loads(r.stdout)
    except ValueError:
        raise ValueError(f"script {path} did not print JSON") from None


RUN_ID = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
RUN_DIR = "/var/log/kvbox/runs"
RUN_MAX_COMMAND = 8 * 1024
RUN_MAX_TIMEOUT = 24 * 3600
RUNS_KEPT = 50
# What a run writes, by stream; ".log" is a run from base v0.15.x, both streams in one file.
RUN_STREAMS = {"stdout": ".out", "stderr": ".err"}
RUN_FILES = (".out", ".err", ".log")
RUN_OUTPUT_MAX = 1 << 20


def run_unit(run_id):
    if not isinstance(run_id, str) or not RUN_ID.match(run_id):
        raise ValueError("run: 'id' must be 1 to 64 letters, digits, '_' or '-'")
    return f"kvbox-run-{run_id}.service"


def run_status(run_id):
    r = subprocess.run(
        ["systemctl", "show", run_unit(run_id), "-p", "LoadState", "-p", "ActiveState", "-p", "SubState",
         "-p", "Result", "-p", "ExecMainCode", "-p", "ExecMainStatus",
         "-p", "ExecMainStartTimestampMonotonic", "-p", "ExecMainExitTimestampMonotonic"],
        check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    unit = dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)
    active, sub = unit.get("ActiveState"), unit.get("SubState")
    if unit.get("LoadState") != "loaded" or active == "inactive":
        return {"state": "unknown"}
    if active in ("activating", "deactivating") or (active == "active" and sub != "exited"):
        return {"state": "running"}
    took = run_duration(unit)
    if unit.get("Result") == "timeout":
        return {"state": "timeout", **took}
    status = int(unit.get("ExecMainStatus") or 0)
    # ExecMainCode: 1 is a plain exit, anything else a signal (2 killed, 3 dumped core)
    return {"state": "exited", "exitCode": status if unit.get("ExecMainCode") in ("0", "1") else 128 + status, **took}


def run_duration(unit):
    """How long the command ran, from systemd's start and exit times (microseconds since boot); nothing
    when either is missing (a command that never started has no start)."""
    try:
        start = int(unit.get("ExecMainStartTimestampMonotonic") or 0)
        end = int(unit.get("ExecMainExitTimestampMonotonic") or 0)
    except ValueError:
        return {}
    return {"durationMs": (end - start) // 1000} if 0 < start <= end else {}


def prune_runs():
    """Keeps the output of the newest RUNS_KEPT runs (a run's newest file dates it; .out, .err, and .log
    from before base v0.16.0), and forgets the units of the ones removed. A run still going is never
    touched."""
    runs = {}  # run id -> (newest mtime, its files)
    try:
        for entry in os.scandir(RUN_DIR):
            run_id, ext = os.path.splitext(entry.name)
            if ext not in RUN_FILES:
                continue
            mtime, files = runs.get(run_id, (0.0, []))
            runs[run_id] = (max(mtime, entry.stat().st_mtime), files + [entry.path])
    except OSError:
        return
    newest = sorted(runs.items(), key=lambda kv: kv[1][0], reverse=True)
    for run_id, (_, files) in newest[RUNS_KEPT - 1:]:  # the run about to start is one of the kept
        try:
            if run_status(run_id)["state"] == "running":
                continue
            unit = run_unit(run_id)
            subprocess.run(["systemctl", "stop", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "reset-failed", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for path in files:
                os.unlink(path)
        except (OSError, ValueError, subprocess.CalledProcessError):
            continue


def run_output(run_id, stream, offset, limit):
    run_unit(run_id)  # checks the id
    if stream not in RUN_STREAMS:
        raise ValueError("runOutput: 'stream' must be stdout or stderr")
    for name, value, top in (("offset", offset, None), ("limit", limit, RUN_OUTPUT_MAX)):
        if not isinstance(value, int) or isinstance(value, bool) or value < 0 or (top is not None and value > top):
            raise ValueError(f"runOutput: '{name}' must be a whole number from 0{'' if top is None else f' to {top}'}")
    path = os.path.join(RUN_DIR, run_id + RUN_STREAMS[stream])
    old = os.path.join(RUN_DIR, run_id + ".log")
    if stream == "stdout" and not os.path.exists(path) and os.path.exists(old):
        path = old
    try:
        with open(path, "rb") as f:
            size = os.fstat(f.fileno()).st_size
            f.seek(offset)
            data = f.read(limit) if offset < size else b""
    except FileNotFoundError:
        size, data = 0, b""
    return {"size": size, "offset": offset, "data": base64.b64encode(data).decode("ascii")}


def run(run_id, command, timeout_sec):
    unit = run_unit(run_id)
    if not isinstance(command, str) or not command.strip() or "\0" in command or len(command.encode()) > RUN_MAX_COMMAND:
        raise ValueError(f"run: 'command' must be a non-empty string of at most {RUN_MAX_COMMAND} bytes")
    if not isinstance(timeout_sec, int) or isinstance(timeout_sec, bool) or not 1 <= timeout_sec <= RUN_MAX_TIMEOUT:
        raise ValueError(f"run: 'timeoutSec' must be a whole number from 1 to {RUN_MAX_TIMEOUT}")
    if run_status(run_id)["state"] != "unknown":
        return False
    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    prune_runs()
    # --expand-environment=no: the command is the shell's to read, systemd must not expand its `$VAR`s first
    sh("systemd-run", "--unit", unit, "--no-block", "--quiet", "--expand-environment=no",
       "--description", f"kvbox run {run_id}",
       "-p", f"User={SSH_USER}", "-p", "WorkingDirectory=~",
       "-p", f"EnvironmentFile=-{ENV_FILE}",
       "-p", f"RuntimeMaxSec={timeout_sec}",
       # the unit stays after a clean exit, so its exit code can still be asked for
       "-p", "RemainAfterExit=yes",
       "-p", f"StandardOutput=append:{os.path.join(RUN_DIR, run_id + RUN_STREAMS['stdout'])}",
       "-p", f"StandardError=append:{os.path.join(RUN_DIR, run_id + RUN_STREAMS['stderr'])}",
       "--", "/bin/bash", "-lc", command)
    return True


UNLOCKED_OPS = ("idle", "script", "runStatus", "runOutput")  # they run something that may be slow, or read up to a MiB


def handle(req):
    op = req.get("op")
    if op == "ping":
        return {"ok": True, "name": socket.gethostname()}
    if op == "identity":
        set_hostname(req["name"])
        set_network(req["ip"], int(req.get("prefixLen", 24)), req["gateway"], req["mac"])
        if "time" in req:
            set_time(req["time"])
        log(f"now {req['name']} at {req['ip']} ({req['mac']})")
        return {"ok": True}
    if op == "authorizedKeys":
        n = set_authorized_keys(req.get("lines"))
        log(f"authorized_keys of {SSH_USER} replaced ({n} lines)")
        return {"ok": True, "lines": n}
    if op == "stats":
        return stats()
    if op == "dropVolumes":
        dropped = drop_volumes()
        if dropped:
            log(f"volume mounts dropped: {', '.join(dropped)}")
        return {"ok": True, "dropped": dropped}
    if op == "env":
        n, changed = set_env(req.get("vars"))
        log(f"environment: {n} variables{', changed' if changed else ''}")
        return {"ok": True, "vars": n, "changed": changed}
    if op == "idle":
        return {"ok": True, "idle": idle(req.get("path"))}
    if op == "script":
        return {"ok": True, "output": script(req.get("path"), req.get("input"))}
    if op == "run":
        started = run(req.get("id"), req.get("command"), req.get("timeoutSec"))
        if started:
            log(f"run {req['id']} started (at most {req['timeoutSec']} s)")
        return {"ok": True, "started": started}
    if op == "runStatus":
        return {"ok": True, **run_status(req.get("id"))}
    if op == "runOutput":
        return {"ok": True, **run_output(req.get("id"), req.get("stream"), req.get("offset", 0), req.get("limit", RUN_OUTPUT_MAX))}
    raise ValueError(f"unknown op {op!r}")


ONE_AT_A_TIME = threading.Lock()


def serve_logged(conn):
    try:
        serve(conn)
    except OSError as e:
        log(f"connection: {e}")


def serve(conn):
    with conn, conn.makefile("rb") as rd, conn.makefile("wb") as wr:
        line = rd.readline()
        if not line:
            return
        try:
            req = json.loads(line)
            if req.get("op") in UNLOCKED_OPS:
                reply = handle(req)
            else:
                with ONE_AT_A_TIME:
                    reply = handle(req)
        except subprocess.CalledProcessError as e:
            reply = {"ok": False, "error": f"{' '.join(e.cmd)}: {e.stderr.strip()}"}
        except Exception as e:  # noqa: BLE001 - report anything to the host rather than die
            reply = {"ok": False, "error": str(e)}
        wr.write(json.dumps(reply).encode() + b"\n")
        wr.flush()


def main():
    srv = socket.socket(socket.AF_VSOCK, socket.SOCK_STREAM)
    srv.bind((socket.VMADDR_CID_ANY, PORT))
    srv.listen(8)
    log(f"listening on vsock port {PORT}")
    while True:
        try:
            conn, _ = srv.accept()
        except OSError as e:
            log(f"accept: {e}")
            time.sleep(0.1)
            continue
        threading.Thread(target=serve_logged, args=(conn,), daemon=True).start()


if __name__ == "__main__":
    main()
