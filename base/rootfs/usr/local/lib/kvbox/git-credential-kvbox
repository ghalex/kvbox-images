#!/usr/bin/env python3
# git's credential helper for https://github.com (kvbox issue #205), named in /etc/gitconfig.
# git calls it with `get`, `store` or `erase` and the request on stdin; only `get` does anything:
# it asks the host for the box owner's GitHub token (kvbox-credential) and answers git with it.
# Nothing is stored, so `store` and `erase` have nothing to do.
#
# When there is no token it prints nothing, and git goes on to the user's own helpers and then asks,
# as it would in any box: a login made inside the box keeps working. One case gets a line on stderr,
# because nothing else would tell the user why: GitHub is connected for the account but not turned
# on for this box.
import json
import socket
import subprocess
import sys


def main():
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return 0
    request = dict(line.split("=", 1) for line in sys.stdin.read().splitlines() if "=" in line)
    if request.get("protocol") != "https" or request.get("host") not in ("github.com", "gist.github.com"):
        return 0
    try:
        out = subprocess.run(["/usr/local/bin/kvbox-credential", "github"], capture_output=True, text=True, timeout=30).stdout
        answer = json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0
    if answer.get("ok") and answer.get("token"):
        print("username=x-access-token")
        print(f"password={answer['token']}")
    elif answer.get("code") == "off" and answer.get("connected"):
        box = socket.gethostname()
        print(f"kvbox: GitHub is connected but not turned on for this box: kvbox vm set {box} --integration github", file=sys.stderr)
    elif answer.get("code") == "needs-reconnect":
        print("kvbox: GitHub no longer accepts the connected account: connect it again in the kvbox web app (Integrations)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
