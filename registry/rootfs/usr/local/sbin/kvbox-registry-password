#!/usr/bin/env python3
# kvbox-registry-password (kvbox #234): give the registry a new password. Named as "password" in
# /etc/kvbox/image.json; the host runs it through kvbox-agent's "script" with one JSON line on stdin:
#
#   {"password": "…"}   ->   {"user": "kvbox"}
#
# /etc/zot/htpasswd is rewritten with the new password's bcrypt hash: written beside its place and
# renamed, so zot never reads half of it. zot watches the file and takes the new one within seconds,
# with no restart; the script answers only once a login with the new password works, and puts the old
# file back if it never does. The password reaches htpasswd on stdin, never argv.
# A `docker login` made with the old password stops working; pushes and pulls under way finish or fail
# at their next request.
# The host then stores the new password as the box's REGISTRY_PASSWORD; nothing here reads it again
# (kvbox-registry-init runs once).
import base64
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

HTPASSWD = "/etc/zot/htpasswd"
USER = "kvbox"
URL = "http://127.0.0.1:5000/v2/"
WAIT = 30  # seconds for zot to take the new file


def fail(msg):
    print(f"kvbox-registry-password: {msg}", file=sys.stderr)
    sys.exit(1)


def accepted(password):
    token = base64.b64encode(f"{USER}:{password}".encode()).decode()
    req = urllib.request.Request(URL, headers={"Authorization": "Basic " + token})
    try:
        with urllib.request.urlopen(req, timeout=5) as res:
            return res.status == 200
    except (urllib.error.URLError, OSError):
        return False


def write(path, text):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    shutil.chown(tmp, "root", "zot")
    os.chmod(tmp, 0o640)
    os.rename(tmp, path)


def main():
    try:
        req = json.loads(sys.stdin.readline())
    except ValueError:
        fail("expected one JSON line on stdin")
    password = req.get("password") if isinstance(req, dict) else None
    if not isinstance(password, str) or not password or any(ord(c) < 32 or ord(c) == 127 for c in password):
        fail("'password' must be a non-empty single line")
    # bcrypt reads the first 72 bytes and ignores the rest.
    if len(password.encode()) > 72:
        fail("'password' must be at most 72 bytes")
    try:
        with open(HTPASSWD, encoding="utf-8") as f:
            old = f.read()
    except OSError:
        fail("the registry has no password yet (kvbox-registry-init has not finished)")

    r = subprocess.run(["htpasswd", "-niB", USER], input=password, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20)
    line = r.stdout.strip()
    if r.returncode != 0 or not line.startswith(USER + ":$2"):
        lines = r.stderr.strip().splitlines()
        fail(lines[-1] if lines else "htpasswd failed")

    write(HTPASSWD, line + "\n")
    deadline = time.monotonic() + WAIT
    while time.monotonic() < deadline:
        if accepted(password):
            print(json.dumps({"user": USER}))
            return
        time.sleep(0.5)
    write(HTPASSWD, old)
    fail(f"zot did not take the new password within {WAIT}s (journalctl -u zot); the old one is kept")


main()
