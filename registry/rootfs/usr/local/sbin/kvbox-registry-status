#!/usr/bin/env python3
# kvbox-registry-status (kvbox #234): what a registry shows about itself. Named as "status" in
# /etc/kvbox/image.json; the host runs it through kvbox-agent's "script" and passes the JSON on.
#
#   {"ready": true, "accepting": true, "version": "2.1.23", "user": "kvbox",
#    "storage": {"usedBytes": 2254857, "totalBytes": 21474836480},
#    "repositories": [{"name": "myapp", "tags": 3, "pushedAt": "2026-11-28T09:14:03Z"}, {"name": "team/api", "tags": 12}]}
#
# ready         kvbox-registry-init has finished: the server has its password and its data directory
# accepting     the server answers on its port (it asks for the login: 401 without one)
# version       zot's own version
# user          the one login's user name
# storage       the filesystem holding the images: the volume when REGISTRY_DATA is set
# repositories  every repository with how many tags it has, by name; read from the data directory
#               (each is an OCI image layout), so it needs no password. At most MAX_REPOSITORIES, and
#               `repositoriesTruncated: true` when there are more. `pushedAt` is when its newest tagged
#               image came into the registry (that manifest's file); absent for one with no tag.
#               The tags themselves are kvbox-registry-tags' to list.
import datetime
import json
import os
import re
import subprocess
import urllib.error
import urllib.request

MARKER = "/var/lib/kvbox/registry-init.done"
CONF = "/etc/zot/config.json"
URL = "http://127.0.0.1:5000/v2/"
USER = "kvbox"
MAX_REPOSITORIES = 1000
TAG = "org.opencontainers.image.ref.name"


def version():
    try:
        r = subprocess.run(["zot", "--version"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    m = re.search(r"v(\d+\.\d+\.\d+)", r.stdout)
    return m.group(1) if m else ""


def accepting():
    try:
        with urllib.request.urlopen(URL, timeout=5) as res:
            return res.status == 200
    except urllib.error.HTTPError as err:
        return err.code == 401
    except (urllib.error.URLError, OSError):
        return False


def data_directory():
    try:
        with open(CONF, encoding="utf-8") as f:
            return json.load(f)["storage"]["rootDirectory"]
    except (OSError, ValueError, KeyError, TypeError):
        return None


def storage(path):
    try:
        fs = os.statvfs(path)
    except OSError:
        return None
    return {"usedBytes": (fs.f_blocks - fs.f_bfree) * fs.f_frsize, "totalBytes": fs.f_blocks * fs.f_frsize}


def pushed(repo_dir, digest):
    """When the manifest of that digest was written, in seconds; None when it cannot be told."""
    algo, _, value = str(digest).partition(":")
    if not re.fullmatch(r"[a-z0-9]+", algo) or not re.fullmatch(r"[a-f0-9]+", value):
        return None
    try:
        return os.stat(os.path.join(repo_dir, "blobs", algo, value)).st_mtime
    except OSError:
        return None


def described(name, repo_dir):
    """A repository's row: how many tags, and when the newest of their images was pushed."""
    try:
        with open(os.path.join(repo_dir, "index.json"), encoding="utf-8") as f:
            manifests = json.load(f).get("manifests") or []
    except (OSError, ValueError, AttributeError):
        return {"name": name, "tags": 0}
    tagged = [m for m in manifests if isinstance(m, dict) and (m.get("annotations") or {}).get(TAG) is not None]
    row = {"name": name, "tags": len({m["annotations"][TAG] for m in tagged})}
    times = [t for t in (pushed(repo_dir, m.get("digest")) for m in tagged) if t]
    if times:
        row["pushedAt"] = datetime.datetime.fromtimestamp(max(times), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return row


def repositories(root):
    """(list, truncated): a directory holding `oci-layout` is a repository, named by its path under the root."""
    found, truncated = [], False
    for path, dirs, files in os.walk(root):
        dirs.sort()
        if "oci-layout" in files:
            dirs[:] = []  # nothing below a repository is another one (blobs/, .uploads/)
            if len(found) >= MAX_REPOSITORIES:
                truncated = True
                break
            found.append(described(os.path.relpath(path, root), path))
        else:
            dirs[:] = [d for d in dirs if not d.startswith((".", "_"))]
    return found, truncated


def main():
    out = {"ready": os.path.exists(MARKER), "accepting": accepting(), "version": version(), "user": USER}
    data = data_directory()
    if data:
        space = storage(data)
        if space:
            out["storage"] = space
        try:
            out["repositories"], truncated = repositories(data)
            if truncated:
                out["repositoriesTruncated"] = True
        except OSError:
            pass
    print(json.dumps(out))


main()
