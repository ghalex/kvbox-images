#!/usr/bin/env python3
# kvbox-k3s-kubeconfig (kvbox #214): the cluster's admin kubeconfig, for use from outside. Named as
# "kubeconfig" in /etc/kvbox/image.json; the host runs it through kvbox-agent's "script" with the
# input on stdin and passes the JSON on. Only the cluster's server answers.
#
#   {"address": "203.0.113.7", "port": 20443, "name": "prod"}   ->   {"kubeconfig": "apiVersion: v1\n…"}
#
# address, port   where the API is reached from outside (the host's address and the published port);
#                 the address must be among the API certificate's names (K3S_TLS_SAN)
# name            optional: what the cluster, user and context are called in the file (k3s calls all
#                 three "default", which collides once someone has two clusters)
import json
import re
import sys

SOURCE = "/etc/rancher/k3s/k3s.yaml"


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def main():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        fail("kubeconfig needs {address, port}")
    address, port, name = data.get("address"), data.get("port"), data.get("name")
    if not isinstance(address, str) or not re.fullmatch(r"[A-Za-z0-9]([A-Za-z0-9.:-]*[A-Za-z0-9])?", address):
        fail("kubeconfig needs the address the API is reached at")
    if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
        fail("kubeconfig needs the port the API is reached at")
    if name is not None and (not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?", name)):
        fail("kubeconfig: the name may only have letters, digits, dots, dashes and underscores")

    try:
        with open(SOURCE, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        fail("this box has no kubeconfig: it is not the cluster's server, or k3s has not started yet")

    host = f"[{address}]" if ":" in address else address
    text, changed = re.subn(r"(?m)^(\s*server:\s*)https://\S+$", lambda m: f"{m.group(1)}https://{host}:{port}", text)
    if changed != 1:
        fail("the kubeconfig k3s wrote does not look as expected (no single server line)")
    if name:
        # k3s writes the cluster, the user and the context as "default", each on a line of its own.
        text = re.sub(r"(?m)^(\s*(?:-\s+)?(?:name|cluster|user|current-context):\s*)default\s*$", lambda m: m.group(1) + name, text)
    print(json.dumps({"kubeconfig": text}))


main()
