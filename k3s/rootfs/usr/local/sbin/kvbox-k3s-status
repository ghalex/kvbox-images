#!/usr/bin/env python3
# kvbox-k3s-status (kvbox #214): what a box of a cluster shows about itself. Named as "status" in
# /etc/kvbox/image.json; the host runs it through kvbox-agent's "script" and passes the JSON on.
#
#   {"ready": true, "role": "server", "version": "v1.37.2+k3s1", "accepting": true,
#    "ingress": true,
#    "nodes": [{"name": "prod-a1", "ready": true, "schedulable": true, "roles": [], "version": "v1.37.2+k3s1",
#               "address": "172.30.0.12", "volumes": 2, "claims": ["default/data-pg-0", "default/cache"]}]}
#
# ready       kvbox-k3s-init has finished: k3s has its role and configuration and came up once
# role        server or agent (absent before the init has read the box's variables)
# version     k3s's own version, from the binary
# accepting   server: the API answers ready; agent: k3s is running and has joined
# ingress     server only, absent while not accepting: Traefik is installed and has a pod available, so
#             the cluster answers on ports 80 and 443
# nodes       server only, absent while not accepting: every node the cluster knows, the server itself
#             included. schedulable is false for a cordoned node; roles are the node-role labels
#             ("control-plane" on the server); volumes counts the bound persistent volumes kept on
#             that node's disk (local-path), which is the data a removal of the node would lose;
#             claims names them (v0.1.2): the claim each is bound to as namespace/name, or the volume's
#             own name when it has none
import json
import os
import re
import subprocess

MARKER = "/var/lib/kvbox/k3s-init.done"
CONF = "/etc/kvbox/k3s.conf"
KUBECONFIG = "/etc/rancher/k3s/k3s.yaml"
K3S = "/usr/local/bin/k3s"
ROLE_LABEL = "node-role.kubernetes.io/"
HOSTNAME_KEYS = ("kubernetes.io/hostname", "metadata.name")


def role():
    try:
        with open(CONF, encoding="utf-8") as f:
            m = re.search(r"^ROLE=(server|agent)$", f.read(), re.M)
    except OSError:
        return None
    return m.group(1) if m else None


def version():
    try:
        out = subprocess.run([K3S, "--version"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"k3s version (\S+)", out)
    return m.group(1) if m else None


def kubectl(*args):
    """kubectl's stdout, or None when the API does not answer."""
    try:
        r = subprocess.run([K3S, "kubectl", "--kubeconfig", KUBECONFIG, "--request-timeout=8s", *args],
                           capture_output=True, text=True, timeout=12)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def volumes_per_node():
    """The bound persistent volumes pinned to each node (local-path names the node's hostname), by their claim."""
    held = {}
    out = kubectl("get", "pv", "-o", "json")
    if out is None:
        return held
    for pv in json.loads(out).get("items", []):
        if pv.get("status", {}).get("phase") != "Bound":
            continue
        terms = pv.get("spec", {}).get("nodeAffinity", {}).get("required", {}).get("nodeSelectorTerms", [])
        names = set()
        for term in terms:
            for match in term.get("matchExpressions", []) + term.get("matchFields", []):
                if match.get("key") in HOSTNAME_KEYS and match.get("operator") == "In":
                    names.update(match.get("values", []))
        claim = pv.get("spec", {}).get("claimRef") or {}
        label = f"{claim.get('namespace', 'default')}/{claim['name']}" if claim.get("name") else pv.get("metadata", {}).get("name", "")
        for name in names:
            held.setdefault(name, []).append(label)
    return held


def nodes():
    out = kubectl("get", "nodes", "-o", "json")
    if out is None:
        return None
    volumes = volumes_per_node()
    result = []
    for node in json.loads(out).get("items", []):
        meta, spec, status = node.get("metadata", {}), node.get("spec", {}), node.get("status", {})
        name = meta.get("name", "")
        ready = any(c.get("type") == "Ready" and c.get("status") == "True" for c in status.get("conditions", []))
        address = next((a.get("address") for a in status.get("addresses", []) if a.get("type") == "InternalIP"), None)
        entry = {
            "name": name,
            "ready": ready,
            "schedulable": not spec.get("unschedulable", False),
            "roles": sorted(k[len(ROLE_LABEL):] for k in meta.get("labels", {}) if k.startswith(ROLE_LABEL) and k != ROLE_LABEL),
            "version": status.get("nodeInfo", {}).get("kubeletVersion"),
            "volumes": len(volumes.get(name, [])),
            "claims": sorted(volumes.get(name, [])),
        }
        if address:
            entry["address"] = address
        result.append(entry)
    return sorted(result, key=lambda n: n["name"])


def ingress():
    out = kubectl("-n", "kube-system", "get", "deployment", "traefik", "-o", "json")
    if out is None:
        return False
    return (json.loads(out).get("status", {}).get("availableReplicas") or 0) >= 1


def main():
    out = {"ready": os.path.exists(MARKER), "accepting": False}
    r = role()
    if r:
        out["role"] = r
    v = version()
    if v:
        out["version"] = v
    if r == "server":
        out["accepting"] = (kubectl("get", "--raw", "/readyz") or "").strip() == "ok"
        if out["accepting"]:
            out["ingress"] = ingress()
            listed = nodes()
            if listed is not None:
                out["nodes"] = listed
    elif r == "agent":
        try:
            out["accepting"] = subprocess.run(["systemctl", "is-active", "--quiet", "k3s.service"], timeout=10).returncode == 0
        except (OSError, subprocess.SubprocessError):
            pass
    print(json.dumps(out))


main()
