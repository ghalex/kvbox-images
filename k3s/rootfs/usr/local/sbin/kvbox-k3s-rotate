#!/usr/bin/env python3
# kvbox-k3s-rotate (kvbox #230, v0.1.5): new credentials for a cluster, so that whatever somebody kept
# (a kubeconfig, a token read on a node) stops working. Named as "rotate" in /etc/kvbox/image.json; the
# host runs it through kvbox-agent's "script" with the input on stdin and passes the JSON on. The caller
# restarts the box afterwards: nothing here takes effect before k3s starts again.
#
# On the cluster's server:
#
#   {"token": "<new server token>", "agentToken": "<new agent token>"}   ->   {"rotated": true, "role": "server"}
#
#   1. the server's own token is replaced (k3s token rotate), unless it already is the new one;
#   2. /etc/rancher/k3s/config.yaml gets both tokens (agent-token is added to a server that had none:
#      from then on its agents hold a token that joins a node and nothing more);
#   3. new certificate authorities are made (server, client, request-header: self-signed, as k3s makes
#      its own) and stored with k3s certificate rotate-ca --force. At its next start k3s issues every
#      certificate again under them, the admin's in the kubeconfig included; a certificate from before,
#      a saved kubeconfig for one, is no longer believed.
#
# In that order: k3s's token rotation writes the certificate authorities it runs with back to the
# datastore, so it must come before the new ones are stored. Each step is safe to do again, so a run that
# stopped half-way is finished by the same request. Not rotated: the key service account tokens are
# signed with (every pod would lose its API access until restarted), so a token made inside the cluster
# stays good; whoever rotates because of a person looks at the cluster's service accounts too.
#
# On an agent:
#
#   {"token": "<new agent token>"}   ->   {"rotated": true, "role": "agent"}
#
#   config.yaml gets the token; at its next start the agent joins with it and is given certificates
#   under the server's new authorities.
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

K3S = "/usr/local/bin/k3s"
CONF = "/etc/kvbox/k3s.conf"
K3S_CONF = "/etc/rancher/k3s/config.yaml"
SERVER_TOKEN = "/var/lib/rancher/k3s/server/token"
RUN_DIR = "/run/kvbox"
# As kvbox-k3s-init takes them: what needs no escaping in a YAML double-quoted string.
TOKEN_RE = r"[A-Za-z0-9._:~+/=@-]{8,}"
CAS = ("server-ca", "client-ca", "request-header-ca")
# openssl's own configuration is not relied on: what a certificate authority's certificate carries is said here.
OPENSSL_CONF = """[req]
distinguished_name = dn
prompt = no
x509_extensions = v3_ca
[dn]
CN = {cn}
[v3_ca]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always
basicConstraints = critical, CA:true
keyUsage = critical, digitalSignature, keyEncipherment, keyCertSign
"""
# The k3s commands read K3S_TOKEN and K3S_URL from the environment before their own files; a script run
# for a box may be given the box's variables, so they get a plain environment.
ENV = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/root", "LC_ALL": "C"}


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def run(*args, timeout=20):
    """The command's last line of complaint, or None when it worked."""
    try:
        r = subprocess.run(list(args), capture_output=True, text=True, timeout=timeout, env=ENV)
    except subprocess.TimeoutExpired:
        return f"{os.path.basename(args[0])} {args[1]} did not finish"
    except OSError as err:
        return str(err)
    if r.returncode == 0:
        return None
    lines = [line for line in (r.stderr + r.stdout).strip().splitlines() if line.strip()]
    return lines[-1] if lines else f"{os.path.basename(args[0])} {args[1]} failed"


def role():
    try:
        with open(CONF, encoding="utf-8") as f:
            m = re.search(r"^ROLE=(server|agent)$", f.read(), re.M)
    except OSError:
        return None
    return m.group(1) if m else None


def set_config(values):
    """config.yaml with each `key: "value"` line replaced, or added after the token's line; written beside its place and renamed."""
    try:
        with open(K3S_CONF, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        fail("this box has no k3s configuration yet: it has not set itself up")
    for key, value in values.items():
        line = f'{key}: "{value}"'
        at = next((i for i, text in enumerate(lines) if text.startswith(f"{key}:")), None)
        if at is not None:
            lines[at] = line
        else:
            after = next((i for i, text in enumerate(lines) if text.startswith("token:")), len(lines) - 1)
            lines.insert(after + 1, line)
    tmp = K3S_CONF + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, K3S_CONF)


def server_token():
    """The token the running server has, without k3s's prefix (K10<hash>::server:<token>); None when unreadable."""
    try:
        with open(SERVER_TOKEN, encoding="utf-8") as f:
            text = f.read().strip()
    except OSError:
        return None
    return text.split("::server:", 1)[1] if "::server:" in text else text


def new_authorities(directory):
    """A self-signed EC certificate authority per name under <directory>/tls, as k3s makes its own."""
    tls = os.path.join(directory, "tls")
    os.makedirs(tls, mode=0o700)
    stamp = int(time.time())
    for name in CAS:
        key, crt, conf = os.path.join(tls, f"{name}.key"), os.path.join(tls, f"{name}.crt"), os.path.join(directory, f"{name}.cnf")
        with open(conf, "w", encoding="utf-8") as f:
            f.write(OPENSSL_CONF.format(cn=f"k3s-{name}@{stamp}"))
        problem = run("openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", key)
        # The key identifiers are what k3s compares to tell a certificate of the old authority from one of the new.
        problem = problem or run("openssl", "req", "-x509", "-new", "-sha256", "-days", "3650", "-key", key, "-out", crt, "-config", conf)
        if problem:
            fail(f"could not make a new certificate authority ({name}): {problem}")
        os.chmod(key, 0o600)


def server(data):
    token, agent = data.get("token"), data.get("agentToken")
    if not isinstance(token, str) or not re.fullmatch(TOKEN_RE, token) or not isinstance(agent, str) or not re.fullmatch(TOKEN_RE, agent):
        fail("rotate needs {token, agentToken}: 8 or more letters, digits and . _ : ~ + / = @ -")
    if token == agent:
        fail("rotate: the agents' token must not be the server's own")
    if not os.path.exists(SERVER_TOKEN):
        fail("k3s has not started on this server yet")
    if server_token() != token:
        problem = run(K3S, "token", "rotate", "--new-token", token)
        if problem:
            fail(f"could not replace the server's token (is k3s up?): {problem}")
    # At once: k3s does not start with a token in its configuration that is not the one its data is kept under.
    set_config({"token": token, "agent-token": agent})
    os.makedirs(RUN_DIR, mode=0o755, exist_ok=True)
    directory = tempfile.mkdtemp(prefix="k3s-rotate-", dir=RUN_DIR)
    try:
        new_authorities(directory)
        problem = run(K3S, "certificate", "rotate-ca", "--force", "--path", directory)
        if problem:
            fail(f"the tokens are new, the certificate authorities are not: {problem}. The same request again finishes it")
    finally:
        shutil.rmtree(directory, ignore_errors=True)
    return {"rotated": True, "role": "server"}


def agent(data):
    token = data.get("token")
    if not isinstance(token, str) or not re.fullmatch(TOKEN_RE, token):
        fail("rotate needs {token}: 8 or more letters, digits and . _ : ~ + / = @ -")
    set_config({"token": token})
    return {"rotated": True, "role": "agent"}


def main():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        fail("rotate needs {token} on an agent, {token, agentToken} on the server")
    r = role()
    if r is None:
        fail("this box has no part in a cluster yet: it has not set itself up")
    print(json.dumps(server(data) if r == "server" else agent(data)))


main()
