#!/usr/bin/env bash
# kvbox-k3s-mounts (kvbox #214): put k3s's directories where they must be, before every start of
# k3s.service. Every step is skipped when already done, so a restart of k3s changes nothing.
#
#   /var/lib/rancher, /var/lib/kubelet   directories of the box's own disk (/rom/overlay/…). A box's /
#       is an overlayfs, and containerd's overlayfs snapshotter refuses to keep its layers on one; the
#       base image does the same for /var/lib/docker.
#   /var/lib/rancher/k3s/agent/images    the images baked into this image
#       (/usr/local/share/kvbox/k3s-images), which k3s loads at start instead of pulling them.
#   /var/lib/rancher/k3s/server          on a server with DATA in /etc/kvbox/k3s.conf (K3S_DATA): that
#       directory of the volume, so the cluster's state lives on the volume. The volume must be
#       mounted: when it is not, this fails and k3s is not started.
#   /var/lib/rancher/k3s/server/manifests/kvbox-traefik.yaml   on a server: Traefik trusts the
#       forwarded headers kvbox's edge sends (kvbox #219).
#   /var/lib/rancher/k3s/server/manifests/kvbox-dns.yaml   on a server: the cluster's DNS asks the
#       box's host, and only it, for a name under .kvbox (kvbox #243).
set -euo pipefail

log() { echo "kvbox-k3s-mounts: $*" >&2; }

bind() { # <source> <target>
  mkdir -p "$1" "$2"
  mountpoint -q "$2" || mount --bind "$1" "$2"
}

role="" data=""
while IFS='=' read -r key value; do
  case "$key" in
    ROLE) role="$value" ;;
    DATA) data="$value" ;;
  esac
done < /etc/kvbox/k3s.conf

# Without a box disk (the image booted straight from its root, no overlay) / is a plain ext4 already.
if [[ -d /rom/overlay ]]; then
  bind /rom/overlay/rancher /var/lib/rancher
  bind /rom/overlay/kubelet /var/lib/kubelet
fi
bind /usr/local/share/kvbox/k3s-images /var/lib/rancher/k3s/agent/images

if [[ "$role" == server && -n "$data" ]]; then
  volume="$(cut -d/ -f1-3 <<< "$data")"
  if ! mountpoint -q "$volume"; then
    log "the cluster's state is on $volume, which is not mounted: k3s is not started without it"
    exit 1
  fi
  install -d -m 0700 "$data"
  bind "$data" /var/lib/rancher/k3s/server
fi

# A server's Traefik believes the X-Forwarded-* headers on its port 80 (kvbox #219). kvbox's edge ends
# TLS and the host passes the request on with the visitor's name as Host, X-Forwarded-Proto: https and
# the visitor's address; Traefik drops such headers from a sender it does not trust, and an app behind it
# would then see plain http from the host's address (wrong redirects, wrong logs). Port 80 of a server is
# reached only by its host and by the cluster's own boxes and pods, never from outside, so every sender
# is trusted. k3s applies whatever is in its manifests directory at each start; written before every
# start, so a cluster made before this has it from its next one.
if [[ "$role" == server ]]; then
  manifests=/var/lib/rancher/k3s/server/manifests
  install -d -m 0700 "$manifests"
  cat > "$manifests/kvbox-traefik.yaml.tmp" <<'YAML'
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    additionalArguments:
      - "--entryPoints.web.forwardedHeaders.insecure=true"
YAML
  mv "$manifests/kvbox-traefik.yaml.tmp" "$manifests/kvbox-traefik.yaml"
fi

# A server's CoreDNS asks the box's host for every name under .kvbox (kvbox #243): `<name>.<slug>.kvbox`
# is how a pod names a database or box the cluster is linked to (`kvbox k8s link`). CoreDNS ends with
# `forward . /etc/resolv.conf`, and the box's resolv.conf lists its host first, then public resolvers
# (the host answers nothing but .kvbox). libc tries those in order; CoreDNS picks one at random, so two
# times in three a public resolver said the name does not exist, and CoreDNS kept that answer. This
# server block takes .kvbox out of that: k3s's CoreDNS imports every `*.server` key of the ConfigMap
# `coredns-custom`. The host is the first nameserver of the box's own resolv.conf, read at every start.
# The ConfigMap is k3s's to write from here on: a key added to it by hand is lost at the next start.
if [[ "$role" == server ]]; then
  resolver="$(awk '$1 == "nameserver" { print $2; exit }' /etc/resolv.conf)"
  if [[ "$resolver" =~ ^[0-9]+(\.[0-9]+){3}$ ]]; then
    cat > "$manifests/kvbox-dns.yaml.tmp" <<YAML
apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns-custom
  namespace: kube-system
data:
  kvbox.server: |
    kvbox:53 {
        errors
        cache 30
        forward . $resolver
    }
YAML
    mv "$manifests/kvbox-dns.yaml.tmp" "$manifests/kvbox-dns.yaml"
  else
    log "no nameserver in /etc/resolv.conf: pods will not resolve names under .kvbox"
  fi
fi
